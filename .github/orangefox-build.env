# OrangeFox CI build configuration for SM-X110 / gta9wifi.
# Edit this file, or override any key at workflow dispatch time.

# OrangeFox source tree
CI_ORANGEFOX_MANIFEST_URL=https://gitlab.com/OrangeFox/Manifest.git
CI_ORANGEFOX_MANIFEST_BRANCH=fox_12.1
CI_ORANGEFOX_SYNC_JOBS=8
CI_DEVICE_TREE_PATH=device/samsung/gta9wifi
CI_LUNCH_TARGET=twrp_gta9wifi-ap2a-eng
CI_BUILD_TARGETS="adbd recoveryimage"
CI_CREATE_ODIN_PACKAGE=true

# Device identity guardrails
CI_DEVICE_CODENAME=gta9wifi
CI_DEVICE_MODEL=SM-X110
CI_BOARD_REQUIREMENT=gta9wifi|mt6789
CI_TARGET_OTA_ASSERT_DEVICE=gta9wifi|SM-X110

# Prebuilt sources
# Supported values: local file/dir path in the checked-out repo, or a direct HTTP(S) URL.
CI_KERNEL_SOURCE=
CI_MODULES_SOURCE=
CI_VENDOR_MODULES_VERSION=5.10

# BoardConfig overrides
CI_BOARD_KERNEL_BASE=0x40078000
CI_BOARD_KERNEL_PAGESIZE=2048
CI_BOARD_RAMDISK_OFFSET=0x11088000
CI_BOARD_KERNEL_TAGS_OFFSET=0x07c08000
CI_BOARD_DTB_OFFSET=0x07c08000
CI_BOARD_BOOT_HEADER_VERSION=2
CI_BOARD_KERNEL_CMDLINE=bootopt=64S3,32N2,64N2
CI_BOARD_BOOTIMAGE_PARTITION_SIZE=67108864
CI_BOARD_RECOVERYIMAGE_PARTITION_SIZE=67108864
CI_BOARD_DTBOIMG_PARTITION_SIZE=8388608
CI_BOARD_SUPER_PARTITION_SIZE=6442450944
CI_BOARD_SAMSUNG_DYNAMIC_PARTITIONS_SIZE=6438256640

# device.mk overrides
CI_TW_CUSTOM_CPU_TEMP_PATH=/sys/class/thermal/thermal_zone1/temp
CI_TW_BRIGHTNESS_PATH=/sys/class/backlight/panel/brightness
CI_TW_LOAD_VENDOR_MODULES="sec_touchscreen.ko mt6789-afe-pcm.ko"

<!--
  vendor/etc/vintf/manifest.xml for:
  Samsung Galaxy Tab A9 WiFi (SM-X110) - codename: gta9wifi
  SoC: MediaTek Helio G99 (MT6789)

  NOTE: This file declares the vendor HAL interfaces required for
  OrangeFox/TWRP to function (decryption, health, gatekeeper).
  Update fqname versions to match your actual vendor HAL versions
  (verify with: adb shell lshal on the stock ROM).
-->
<manifest version="7.0" type="device" target-level="8">
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IServiceManager/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hidl.token</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ITokenManager/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.health</name>
        <version>2</version>
        <fqname>IHealth/default</fqname>
    </hal>
</manifest>

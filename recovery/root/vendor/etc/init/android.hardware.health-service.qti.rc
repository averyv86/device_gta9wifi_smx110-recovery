# Health HAL service for Samsung Galaxy Tab A9 WiFi (SM-X110)
#
# NOTE: Verify the actual health service binary name on your device:
#   adb shell ls /vendor/bin/hw/ | grep -i health
# Replace 'android.hardware.health-service.samsung' with the correct binary.

on fs
    start vendor.health

service vendor.health /vendor/bin/hw/android.hardware.health-service.samsung
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
    disabled

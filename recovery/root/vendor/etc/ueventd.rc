# ueventd.rc for:
# Samsung Galaxy Tab A9 WiFi (SM-X110) - codename: gta9wifi
# SoC: MediaTek Helio G99 (MT6789)
#
# NOTE: Update this file with entries from your device's actual vendor ueventd.rc

# Firmware search paths
firmware_directories /vendor/firmware/ /odm/firmware/

# Generic input
/dev/input/*                    0660    root        input

# Camera / Flashlight
/dev/video*                     0660    camera      camera
/dev/media*                     0660    camera      camera
/dev/v4l-subdev*                0660    camera      camera
/sys/class/leds/torch-sec1      0660    system      system

# Battery / Charger
/dev/battery                    0660    system      system

# Crypto / TEE (MediaTek)
/dev/teeTrustzoneDevice         0600    system      system
/dev/tee*                       0600    system      system

# USB Gadget
/dev/usb-ffs/*                  0660    shell       shell

# Thermal
/sys/class/thermal/*            0660    system      system

# Block devices (eMMC)
/dev/block/mmcblk0*             0660    root        system
/dev/block/mmcblk1*             0660    root        system

# DRM / Widevine
/dev/dri/*                      0666    root        graphics
/dev/graphics/*                 0666    root        graphics

# ueventd.rc for:
# Samsung Galaxy Tab A9 WiFi (SM-X110) - codename: gta9wifi
# SoC: MediaTek Helio G99 (MT6789)

# TouchScreen input device
/dev/input/*                0660    root      input

# MicroSD
/dev/block/mmcblk1*         0660    root      system

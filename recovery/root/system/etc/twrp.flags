# twrp.flags for:
# Samsung Galaxy Tab A9 WiFi (SM-X110) - codename: gta9wifi
# SoC: MediaTek Helio G99 (MT6789), non-A/B partition scheme
#
# NOTE: Verify all partition names against your device with:
#   adb shell ls -la /dev/block/by-name/

# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point          fstype  device                                        device2              flags

# Special logical partitions
/system_ext            ext4    system_ext                                                         flags=display="System EXT";logical;nofail
/odm                   ext4    odm                                                                flags=display="ODM";logical;nofail

# Boot partitions (non-A/B — no slot suffix)
/boot                  emmc    /dev/block/by-name/boot                                            flags=display="Boot";backup=1;flashimg=1
/recovery              emmc    /dev/block/by-name/recovery                                        flags=display="Recovery";backup=1;flashimg=1
/dtbo                  emmc    /dev/block/by-name/dtbo                                            flags=display="DTBO";backup=1;flashimg=1
/vbmeta                emmc    /dev/block/by-name/vbmeta                                          flags=display="VBMeta";backup=1;flashimg=1

# Data / Metadata
/metadata              ext4    /dev/block/by-name/metadata                                        flags=display="Metadata";backup=1

# Cache (Samsung non-A/B devices have a dedicated cache partition)
/cache                 ext4    /dev/block/by-name/cache                                           flags=display="Cache";backup=1;wipeduringfactoryreset

# Samsung EFS — modem security/DRM keys. CRITICAL to back up before wiping.
# NOTE: Verify the partition name; some Samsung variants use 'efs' or 'modemst1'/'modemst2'
/efs                   ext4    /dev/block/by-name/efs                                             flags=display="EFS (Modem Keys)";backup=1

# Samsung param partition (stores reboot reason, download mode state, etc.)
/param                 emmc    /dev/block/by-name/param                                           flags=display="Param";backup=1

# MediaTek NVRAM / Factory data — calibration and config data
# NOTE: Verify these partition names on your SM-X110
/nvdata                ext4    /dev/block/by-name/nvdata                                          flags=display="NVData";backup=1
/nvram                 emmc    /dev/block/by-name/nvram                                           flags=display="NVRAM";backup=1

# MediaTek protect partitions
/protect_f             ext4    /dev/block/by-name/protect_f                                       flags=display="Protect-F";backup=1
/protect_s             ext4    /dev/block/by-name/protect_s                                       flags=display="Protect-S";backup=1

# Removable storage
/sdcard2               auto    /dev/block/mmcblk1p1                       /dev/block/mmcblk1      flags=display="MicroSD";fsflags="utf8";storage;removable
/usb_otg               auto    /dev/block/sdg1                            /dev/block/sdg          flags=display="USB-Storage";fsflags="utf8,sync";storage;formattable;removable
/storage               auto    /data/media/0                                                      flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable

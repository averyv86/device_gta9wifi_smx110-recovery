#
# Samsung Galaxy Tab A9 WiFi (SM-X110) uses a single sysfs torch node
# (/sys/class/leds/torch-sec1/brightness) that OrangeFox controls directly
# via OF_FL_PATH1 — no virtual torch daemon is required.
#
# This service block is retained but disabled. Enable it only if the
# direct-sysfs approach does not work on your kernel build.

service virtual_torch /system/bin/virtual_torch.sh
    user root
    group root
    priority 5
    disabled
    seclabel u:r:recovery:s0

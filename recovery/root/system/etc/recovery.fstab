#
# recovery.fstab for:
# Samsung Galaxy Tab A9 WiFi (SM-X110) - codename: gta9wifi
# SoC: MediaTek Helio G99 (MT6789), non-A/B partition scheme
#
# NOTE: Verify all partition names against your device with:
#   adb shell ls -la /dev/block/by-name/

# Android fstab file.
# <device>                              <mount point>  <fstype>  <flags>

# Logical partitions (inside super)
system                                  /system        ext4      ro                                             wait,logical,first_stage_mount
system_ext                              /system_ext    ext4      ro                                             wait,logical,first_stage_mount,nofail
product                                 /product       ext4      ro                                             wait,logical,first_stage_mount,nofail
vendor                                  /vendor        ext4      ro                                             wait,logical,first_stage_mount
odm                                     /odm           ext4      ro                                             wait,logical,first_stage_mount,nofail

# Physical Partitions
/dev/block/by-name/userdata             /data          f2fs      noatime,nosuid,nodev,discard                   latemount,wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts,quota,reservedsize=128M
/dev/block/by-name/metadata             /metadata      ext4      noatime,nosuid,nodev                           wait,check,formattable
/dev/block/by-name/misc                 /misc          emmc      defaults                                       defaults
/dev/block/by-name/cache                /cache         ext4      noatime,nosuid,nodev,barrier=1                 wait
